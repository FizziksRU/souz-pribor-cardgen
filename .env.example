# Скопируйте в .env и заполните. Файл .env исключён из git.
# Провайдер — polza.ai (https://polza.ai): ключ создаётся в кабинете, раздел API Keys.
LLM_PROVIDER=polza
LLM_API_KEY=
# Идентификатор модели из каталога https://polza.ai/models
LLM_MODEL=anthropic/claude-sonnet-5.5

# Необязательно. Глубина рассуждений: none, minimal, low, medium, high, xhigh, max.
# Пусто — как у модели по умолчанию. Рассуждения оплачиваются как выходные токены.
LLM_REASONING=
# Необязательно. 0–2; новые модели OpenAI и Anthropic этот параметр не принимают.
LLM_TEMPERATURE=
